DATABASE_URL=
PORT=
NODE_ENV=
CORS_ORIGIN=

# NASA FIRMS satellite thermal hotspot data (optional but recommended)
# Free API key: https://firms.modaps.eosdis.nasa.gov/api/area/
# If not set, FIRMS provider is skipped silently.
FIRMS_MAP_KEY=

# aisstream.io real-time AIS vessel tracking (optional)
# Free API key: https://aisstream.io
# If not set, vessel tracking is disabled silently.
AIS_API_KEY=

# X (Twitter) bot — posts critical events automatically (optional)
# Free plan: 500 tweets/month. App needs Read+Write permissions.
# Get keys at: https://developer.twitter.com/en/portal/dashboard
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Your deployed site URL (used in tweet footer)
SITE_URL=https://conflict-terminal.xyz
